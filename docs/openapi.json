              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/entities": {
      "post": {
        "summary": "Entity",
        "operationId": "entity_v1_entities_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntityInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/accounts": {
      "post": {
        "summary": "Account",
        "operationId": "account_v1_accounts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/transactions": {
      "post": {
        "summary": "Ingest",
        "operationId": "ingest_v1_transactions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestOutput"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/accounts/{account_id}/trace": {
      "get": {
        "summary": "Trace",
        "operationId": "trace_v1_accounts__account_id__trace_get",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Account Id"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "End"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "title": "Currency"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(forward|backward)$",
              "default": "forward",
              "title": "Direction"
            }
          },
          {
            "name": "max_hops",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "default": 5,
              "title": "Max Hops"
            }
          },
          {
            "name": "max_paths",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Max Paths"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceOutput"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Id"
          },
          "entity_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Entity Id"
          },
          "institution": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Institution"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "entity_id",
          "institution"
        ],
        "title": "AccountInput"
      },
      "EntityInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Id"
          },
          "kind": {
            "$ref": "#/components/schemas/EntityKind"
          },
          "display_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Display Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "display_name"
        ],
        "title": "EntityInput"
      },
      "EntityKind": {
        "type": "string",
        "enum": [
          "person",
          "organization"
        ],
        "title": "EntityKind"
      },
      "FindingOutput": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "weight": {
            "type": "integer",
            "title": "Weight"
          },
          "transaction_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Transaction Ids"
          },
          "account_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Account Ids"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          }
        },
        "type": "object",
        "required": [
          "code",
          "weight",
          "transaction_ids",
          "account_ids",
          "explanation"
        ],
        "title": "FindingOutput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestInput": {
        "properties": {
          "transactions": {
            "items": {
              "$ref": "#/components/schemas/TransactionInput"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Transactions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transactions"
        ],
        "title": "IngestInput"
      },
      "IngestOutput": {
        "properties": {
          "accepted": {
            "type": "integer",
            "title": "Accepted"
          },
          "duplicates": {
            "type": "integer",
            "title": "Duplicates"
          }
        },
        "type": "object",
        "required": [
          "accepted",
          "duplicates"
        ],
        "title": "IngestOutput"
      },
      "PathOutput": {
        "properties": {
          "account_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Account Ids"
          },
          "transaction_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Transaction Ids"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "bottleneck_amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Bottleneck Amount"
          },
          "elapsed_seconds": {
            "type": "number",
            "title": "Elapsed Seconds"
          },
          "risk_score": {
            "type": "integer",
            "title": "Risk Score"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/FindingOutput"
            },
            "type": "array",
            "title": "Findings"
          },
          "terminated_by_cycle": {
            "type": "boolean",
            "title": "Terminated By Cycle"
          }
        },
        "type": "object",
        "required": [
          "account_ids",
          "transaction_ids",
          "currency",
          "bottleneck_amount",
          "elapsed_seconds",
          "risk_score",
          "findings",
          "terminated_by_cycle"
        ],
        "title": "PathOutput"
      },
      "TraceOutput": {
        "properties": {
          "paths": {
            "items": {
              "$ref": "#/components/schemas/PathOutput"
            },
            "type": "array",
            "title": "Paths"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          },
          "expansions": {
            "type": "integer",
            "title": "Expansions"
          },
          "rule_version": {
            "type": "string",
            "title": "Rule Version"
          },
          "attribution_method": {
            "type": "string",
            "title": "Attribution Method"
          },
          "assumptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Assumptions"
          }
        },
        "type": "object",
        "required": [
          "paths",
          "truncated",
          "expansions",
          "rule_version",
          "attribution_method",
          "assumptions"
        ],
        "title": "TraceOutput"
      },
      "TransactionInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Id"
          },
          "source_account_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Source Account Id"
          },
          "destination_account_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Destination Account Id"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "source_system": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Source System"
          },
          "external_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "External Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "source_account_id",
          "destination_account_id",
          "amount",
          "currency",
          "occurred_at",
          "source_system",
          "external_id"
        ],
        "title": "TransactionInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
