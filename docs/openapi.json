{
  "components": {
    "schemas": {
      "AccountInput": {
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Entity Id",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Id",
            "type": "string"
          },
          "institution": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Institution",
            "type": "string"
          }
        },
        "required": [
          "id",
          "entity_id",
          "institution"
        ],
        "title": "AccountInput",
        "type": "object"
      },
      "EntityInput": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/EntityKind"
          }
        },
        "required": [
          "id",
          "kind",
          "display_name"
        ],
        "title": "EntityInput",
        "type": "object"
      },
      "EntityKind": {
        "enum": [
          "person",
          "organization"
        ],
        "title": "EntityKind",
        "type": "string"
      },
      "FindingOutput": {
        "properties": {
          "account_ids": {
            "items": {
              "type": "string"
            },
            "title": "Account Ids",
            "type": "array"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "transaction_ids": {
            "items": {
              "type": "string"
            },
            "title": "Transaction Ids",
            "type": "array"
          },
          "weight": {
            "title": "Weight",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "weight",
          "transaction_ids",
          "account_ids",
          "explanation"
        ],
        "title": "FindingOutput",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IngestInput": {
        "additionalProperties": false,
        "properties": {
          "transactions": {
            "items": {
              "$ref": "#/components/schemas/TransactionInput"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Transactions",
            "type": "array"
          }
        },
        "required": [
          "transactions"
        ],
        "title": "IngestInput",
        "type": "object"
      },
      "IngestOutput": {
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "integer"
          },
          "duplicates": {
            "title": "Duplicates",
            "type": "integer"
          }
        },
        "required": [
          "accepted",
          "duplicates"
        ],
        "title": "IngestOutput",
        "type": "object"
      },
      "PathOutput": {
        "properties": {
          "account_ids": {
            "items": {
              "type": "string"
            },
            "title": "Account Ids",
            "type": "array"
          },
          "bottleneck_amount": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Bottleneck Amount",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "elapsed_seconds": {
            "title": "Elapsed Seconds",
            "type": "number"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/FindingOutput"
            },
            "title": "Findings",
            "type": "array"
          },
          "risk_score": {
            "title": "Risk Score",
            "type": "integer"
          },
          "terminated_by_cycle": {
            "title": "Terminated By Cycle",
            "type": "boolean"
          },
          "transaction_ids": {
            "items": {
              "type": "string"
            },
            "title": "Transaction Ids",
            "type": "array"
          }
        },
        "required": [
          "account_ids",
          "transaction_ids",
          "currency",
          "bottleneck_amount",
          "elapsed_seconds",
          "risk_score",
          "findings",
          "terminated_by_cycle"
        ],
        "title": "PathOutput",
        "type": "object"
      },
      "TraceOutput": {
        "properties": {
          "assumptions": {
            "items": {
              "type": "string"
            },
            "title": "Assumptions",
            "type": "array"
          },
          "attribution_method": {
            "title": "Attribution Method",
            "type": "string"
          },
          "expansions": {
            "title": "Expansions",
            "type": "integer"
          },
          "paths": {
            "items": {
              "$ref": "#/components/schemas/PathOutput"
            },
            "title": "Paths",
            "type": "array"
          },
          "rule_version": {
            "title": "Rule Version",
            "type": "string"
          },
          "snapshot_sha256": {
            "title": "Snapshot Sha256",
            "type": "string"
          },
          "transaction_count": {
            "title": "Transaction Count",
            "type": "integer"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "paths",
          "truncated",
          "expansions",
          "snapshot_sha256",
          "transaction_count",
          "rule_version",
          "attribution_method",
          "assumptions"
        ],
        "title": "TraceOutput",
        "type": "object"
      },
      "TransactionInput": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "destination_account_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Destination Account Id",
            "type": "string"
          },
          "external_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "External Id",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "source_account_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Source Account Id",
            "type": "string"
          },
          "source_system": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Source System",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_account_id",
          "destination_account_id",
          "amount",
          "currency",
          "occurred_at",
          "source_system",
          "external_id"
        ],
        "title": "TransactionInput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "OR TRACE",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "health_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    },
    "/v1/accounts": {
      "post": {
        "operationId": "account_v1_accounts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Account"
      }
    },
    "/v1/accounts/{account_id}/trace": {
      "get": {
        "operationId": "trace_v1_accounts__account_id__trace_get",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "Start",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "End",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "currency",
            "required": true,
            "schema": {
              "pattern": "^[A-Z]{3}$",
              "title": "Currency",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "default": "forward",
              "pattern": "^(forward|backward)$",
              "title": "Direction",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "max_hops",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 10,
              "minimum": 1,
              "title": "Max Hops",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "max_paths",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Max Paths",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceOutput"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Trace"
      }
    },
    "/v1/entities": {
      "post": {
        "operationId": "entity_v1_entities_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntityInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Entity"
      }
    },
    "/v1/transactions": {
      "post": {
        "operationId": "ingest_v1_transactions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestOutput"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ingest"
      }
    }
  }
}
